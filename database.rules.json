{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true"
      }
    },
    "typing": {
      "$roomId": {
        ".read": "auth != null && auth.token.email_verified == true",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid && auth.token.email_verified == true",
          ".validate": "newData.hasChildren(['p', 't']) && newData.child('t').isNumber() && newData.child('p').isString()"
        }
      }
    }
  }
}
