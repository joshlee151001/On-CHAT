$("login-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  showLoginMsg("");

  const phone = onlyDigits($("phone").value);
  const nickname = $("nickname").value.trim();

  if (!isValidPhone(phone)) {
    showLoginMsg("전화번호를 다시 확인해 주세요.");
