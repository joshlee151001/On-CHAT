/* ================= 사진 압축 ================= */
// 사진을 캔버스에 줄여 그린 뒤 JPEG 글자(data URL)로 바꿈
// Firestore 문서 하나는 1MB까지라서 maxBytes 아래로 맞춤
function compressImage(file, { maxSide, quality, maxBytes }) {
  return new Promise((resolve, reject) => {
    if (!file.type.startsWith("image/")) {
      reject(new Error("사진 파일이 아니에요"));
      return;
    }
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      let side = maxSide;
      let q = quality;
      for (let tries = 0; tries < 8; tries++) {
        const scale = Math.min(1, side / Math.max(img.width, img.height));
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        const ctx = canvas.getContext("2d");
        ctx.fillStyle = "#fff"; // 투명 PNG 배경이 까맣게 되는 것 방지
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        const data = canvas.toDataURL("image/jpeg", q);
        if (data.length <= maxBytes) {
          resolve(data);
          return;
        }
        // 너무 크면 화질/크기 줄여서 다시
        if (q > 0.5) q -= 0.1;
        else side = Math.round(side * 0.8);
      }
      reject(new Error("사진이 너무 커요"));
    };
    img.onerror = () => {
      URL.revokeObjectURL(url);
      reject(new Error("사진을 읽지 못했어요"));
    };
    img.src = url;
  });
}

