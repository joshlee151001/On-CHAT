/* ================= 채팅방 열기 / 닫기 ================= */
function openRoom(id) {
  closeRoom();
  roomMessages = [];
  currentRoom = { id, members: [myPhone], lastRead: {}, unread: {}, joinedAt: {}, loaded: false };
  $("chat-title").textContent = "";
  $("msg-list").replaceChildren();
  $("chat-screen").classList.remove("hidden");
  let firstLoad = true;

  // 방 정보 (읽음 상태·인원·이름이 바뀌면 다시 그림)
  const stopRoom = onSnapshot(doc(db, "rooms", id), async (snap) => {
    if (!snap.exists() || !currentRoom || currentRoom.id !== id) return;
    const data = snap.data();
    await Promise.all(data.members.filter((p) => p !== myPhone).map(getUser));
    if (!currentRoom || currentRoom.id !== id) return;
    currentRoom = { id, ...data, loaded: true };
    fillTitle($("chat-title"), currentRoom);
    renderMessages(firstLoad);
    if (roomMessages.length) firstLoad = false;
    markRead();
  });

  // 메시지 (최근 200개)
  const stopMsgs = onSnapshot(
    query(collection(db, "rooms", id, "messages"), orderBy("clientAt"), limitToLast(200)),
    async (snap) => {
      if (!currentRoom || currentRoom.id !== id) return;
      roomMessages = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
      // 처음 보는 보낸 사람(나간 사람 등) 프로필도 읽어둠
      await Promise.all([...new Set(roomMessages.map((m) => m.sender))].map(getUser));
      if (!currentRoom || currentRoom.id !== id || !currentRoom.loaded) return;
      renderMessages(firstLoad);
      firstLoad = false;
      markRead();
    },
    (err) => console.error(err)
  );

  stopRoomListeners = [stopRoom, stopMsgs];
  setTimeout(() => $("chat-text").focus(), 50);
}

function closeRoom() {
  stopRoomListeners.forEach((stop) => stop());
  stopRoomListeners = [];
  currentRoom = null;
  roomMessages = [];
  $("chat-screen").classList.add("hidden");
  $("chat-form").reset();
  $("chat-text").style.height = "";
  $("send-btn").disabled = true;
}

$("chat-back").addEventListener("click", closeRoom);

/* ================= 읽음 처리 ================= */
// 방을 보고 있을 때 "여기까지 읽었음" 기록 + 내 안 읽음 수 0
function markRead() {
  if (!currentRoom || !currentRoom.loaded || document.visibilityState !== "visible") return;
  if (!currentRoom.members.includes(myPhone)) return;
  const last = roomMessages[roomMessages.length - 1];
  const myLastRead = (currentRoom.lastRead && currentRoom.lastRead[myPhone]) || 0;
  const needed = myUnread(currentRoom) > 0 || (last && last.clientAt > myLastRead);
  if (!needed) return;

  updateDoc(doc(db, "rooms", currentRoom.id), {
    [`lastRead.${myPhone}`]: Date.now(),
    [`unread.${myPhone}`]: 0,
  }).catch((err) => console.error(err));
}

// 다른 탭 보다가 돌아오면 읽음 처리
document.addEventListener("visibilitychange", markRead);

/* ================= 메시지 그리기 ================= */
function minuteKey(m) {
  return Math.floor(m.clientAt / 60000);
}

// 같은 사람이 같은 분에 연달아 보낸 메시지는 한 묶음 (안내 문구는 묶음을 끊음)
function sameGroup(a, b) {
  return (
    a && b &&
    a.type !== "system" && b.type !== "system" &&
    a.sender === b.sender &&
    minuteKey(a) === minuteKey(b)
  );
}

// 이 메시지를 아직 안 읽은 사람 수
// (보낸 사람 빼고, 메시지 보낸 뒤에 들어온 사람도 빼고)
function unreadCount(m) {
  const lastRead = currentRoom.lastRead || {};
  const joinedAt = currentRoom.joinedAt || {};
  return currentRoom.members.filter(
    (p) => p !== m.sender && (joinedAt[p] || 0) <= m.clientAt && (lastRead[p] || 0) < m.clientAt
  ).length;
}

function openViewer(src) {
  $("viewer-img").src = src;
  $("viewer").classList.remove("hidden");
}
$("viewer").addEventListener("click", () => $("viewer").classList.add("hidden"));

function renderMessages(forceBottom) {
  if (!currentRoom || !currentRoom.loaded) return;
  const box = $("msg-list");
  const nearBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 80;

  // 내가 들어오기 전 대화는 안 보여줌
  const myJoin = (currentRoom.joinedAt && currentRoom.joinedAt[myPhone]) || 0;
  const msgs = roomMessages.filter((m) => m.clientAt >= myJoin);

  const nodes = [];
  msgs.forEach((m, i) => {
    const prev = msgs[i - 1];
    const next = msgs[i + 1];
    const day = new Date(m.clientAt);

    // 날짜가 바뀌면 구분선
    const newDay = !prev || !sameDay(new Date(prev.clientAt), day);
    if (newDay) {
      const divider = el("div", "day-divider");
      divider.appendChild(el("span", null, formatDay(m.clientAt)));
      nodes.push(divider);
    }

    // 안내 문구 (초대/나가기/이름 변경)
    if (m.type === "system") {
      const sys = el("div", "system-msg");
      sys.appendChild(el("span", null, m.text));
      nodes.push(sys);
      return;
    }

    const first = newDay || !sameGroup(prev, m);
    const lastInGroup = !next || !sameGroup(m, next) || !sameDay(new Date(next.clientAt), day);
    const mine = m.sender === myPhone;

    const row = el("div", `msg ${mine ? "mine" : "other"}${first ? " first" : ""}`);
    const body = el("div", "body");

    if (!mine) {
      const sender = userOf(m.sender);
      if (first) {
        row.appendChild(makeAvatar(sender));
        body.appendChild(el("div", "sender", sender.nickname));
      } else {
        row.appendChild(el("div", "avatar-space"));
      }
    }

    const line = el("div", "line");
    const meta = el("div", "meta");
    const count = unreadCount(m);
    if (count > 0) meta.appendChild(el("span", "unread", String(count)));
    if (lastInGroup) meta.appendChild(el("span", "time", formatTime(m.clientAt)));

    let content;
    if (m.type === "image") {
      content = el("img", "photo");
      content.src = m.image;
      content.alt = "사진";
      content.loading = "lazy";
      content.addEventListener("click", () => openViewer(m.image));
      // 사진이 늦게 로드되면 맨 아래 위치가 밀리니까 다시 맞춤
      content.addEventListener("load", () => {
        if (box.scrollHeight - box.scrollTop - box.clientHeight < 400) box.scrollTop = box.scrollHeight;
      });
    } else {
      content = el("div", "bubble", m.text);
    }

    line.append(content, meta);
    body.appendChild(line);
    row.appendChild(body);
    nodes.push(row);
  });

  box.replaceChildren(...nodes);

  // 맨 아래 보고 있었거나, 처음 열었거나, 내가 방금 보냈으면 맨 아래로
  const last = msgs[msgs.length - 1];
  if (forceBottom || nearBottom || (last && last.sender === myPhone)) {
    box.scrollTop = box.scrollHeight;
  }
}

/* ================= 메시지 보내기 ================= */
const chatText = $("chat-text");

function autoGrow() {
  chatText.style.height = "auto";
  chatText.style.height = Math.min(chatText.scrollHeight, 110) + "px";
  $("send-btn").disabled = chatText.value.trim() === "";
}
chatText.addEventListener("input", autoGrow);

// Enter = 보내기, Shift+Enter = 줄바꿈
// isComposing: 한글 조합 중 Enter는 무시 (안 그러면 마지막 글자가 한 번 더 보내짐)
chatText.addEventListener("keydown", (e) => {
  if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
    e.preventDefault();
    sendText();
  }
});

$("chat-form").addEventListener("submit", (e) => {
  e.preventDefault();
  sendText();
});

async function sendText() {
  const text = chatText.value.trim();
  if (!text || !currentRoom || !currentRoom.loaded) return;

  chatText.value = "";
  autoGrow();
  chatText.focus();

  const ok = await sendPayload({ type: "text", text }, text);
  if (!ok && !chatText.value) {
    chatText.value = text; // 실패하면 입력창에 되돌려 놓기
    autoGrow();
  }
}

// 사진 보내기
$("attach-btn").addEventListener("click", () => $("photo-input").click());

$("photo-input").addEventListener("change", async (e) => {
  const file = e.target.files[0];
  e.target.value = "";
  if (!file || !currentRoom) return;

  $("attach-btn").disabled = true;
  toast("사진 보내는 중...");
  try {
    // 채팅 사진: 긴 쪽 1280px, Firestore 1MB 제한 안쪽으로
    const image = await compressImage(file, { maxSide: 1280, quality: 0.75, maxBytes: 700000 });
    await sendPayload({ type: "image", image, text: "" }, "사진");
  } catch (err) {
    toast(err.message || "사진을 보내지 못했어요");
  } finally {
    $("attach-btn").disabled = false;
  }
});

// 메시지 저장 + 방 정보 갱신을 한 번에 (둘 중 하나만 되는 일 없게)
async function sendPayload(payload, preview) {
  const room = currentRoom;
  const now = Date.now();
  const roomRef = doc(db, "rooms", room.id);
  const msgRef = doc(collection(db, "rooms", room.id, "messages")); // 새 메시지 자리 (자동 ID)

  const batch = writeBatch(db);
  batch.set(msgRef, {
    ...payload,
    sender: myPhone,
    clientAt: now,
    createdAt: serverTimestamp(),
  });

  const roomUpdate = {
    lastMessage: preview,
    lastAt: now,
    lastSender: myPhone,
    [`lastRead.${myPhone}`]: now,
  };

  // 받을 사람: 단톡은 지금 멤버, 1:1은 상대가 나갔어도 다시 불러옴 (카톡 방식)
  let recipients = room.members.filter((p) => p !== myPhone);
  if (!isGroup(room)) {
    const partner = dmPartner(room);
    recipients = [partner];
    if (!room.members.includes(partner)) {
      roomUpdate.members = arrayUnion(partner);
      roomUpdate[`joinedAt.${partner}`] = now;
    }
  }
  recipients.forEach((p) => (roomUpdate[`unread.${p}`] = increment(1)));
  batch.update(roomRef, roomUpdate);

  try {
    await batch.commit();
    return true;
  } catch (err) {
    console.error(err);
    toast("메시지를 보내지 못했어요");
    return false;
  }
}

/* ================= 로그아웃 ================= */
$("logout-btn").addEventListener("click", async () => {
  if (!confirm("로그아웃할까요?")) return;
  closeAllModals();
  closeRoom();
  stopListeners.forEach((stop) => stop());
  stopListeners = [];
  rooms = [];
  userCache.clear();
  userInfo.clear();
  renderRooms();
  myPhone = null;
  me = null;
  friends = [];
  friendSet = new Set();

  localStorage.removeItem("onchat-phone");
  await signOut(auth);

  $("main-screen").classList.add("hidden");
  $("login-screen").classList.remove("hidden");
  $("login-form").reset();
  showLoginMsg("");
});
