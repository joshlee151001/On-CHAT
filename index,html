/* ================= 단톡방 만들기 / 초대 / 이름 변경 / 나가기 ================= */
function namesText(phones) {
  return phones.map((p) => `${nameOf(p)}님`).join(", ");
}

// 안내 문구(시스템 메시지)를 방에 남기는 batch 작업 추가
function addSystemMessage(batch, roomId, text, now) {
  const msgRef = doc(collection(db, "rooms", roomId, "messages"));
  batch.set(msgRef, {
    type: "system",
    sender: myPhone,
    text,
    clientAt: now,
    createdAt: serverTimestamp(),
  });
}

async function createGroup(members, name, invited) {
  const now = Date.now();
  const ref = doc(collection(db, "rooms")); // 자동 ID
  const joinedAt = {};
  members.forEach((p) => (joinedAt[p] = now));
  const text = `${nameOf(myPhone)}님이 ${namesText(invited)}을 초대했습니다.`;

  const batch = writeBatch(db);
  batch.set(ref, {
    type: "group",
    name: name || "",
    members,
    lastMessage: text,
    lastAt: now,
    lastSender: myPhone,
    lastRead: { [myPhone]: now },
    unread: {},
    joinedAt,
    createdBy: myPhone,
    createdAt: serverTimestamp(),
  });
  addSystemMessage(batch, ref.id, text, now);
  await batch.commit();
  return ref.id;
}

async function inviteToCurrentRoom(selected) {
  const room = currentRoom;

  // 1:1 방에서 초대하면 → 셋 이상 새 단톡방 (카톡 방식)
  if (!isGroup(room)) {
    const partner = dmPartner(room);
    const id = await createGroup([myPhone, partner, ...selected], "", [partner, ...selected]);
    closeModal("room-menu");
    openRoom(id);
    return;
  }

  const now = Date.now();
  const text = `${nameOf(myPhone)}님이 ${namesText(selected)}을 초대했습니다.`;
  const update = {
    members: arrayUnion(...selected),
    lastMessage: text,
    lastAt: now,
    lastSender: myPhone,
  };
  selected.forEach((p) => {
    update[`joinedAt.${p}`] = now;  // 이 시간 이전 대화는 안 보임
    update[`lastRead.${p}`] = now;
    update[`unread.${p}`] = 0;
  });

  const batch = writeBatch(db);
  batch.update(doc(db, "rooms", room.id), update);
  addSystemMessage(batch, room.id, text, now);
  await batch.commit();
  closeModal("room-menu");
}

async function renameCurrentRoom() {
  const room = currentRoom;
  const name = prompt("채팅방 이름 (비우면 참여자 이름으로 표시)", room.name || "");
  if (name === null) return;
  const trimmed = name.trim().slice(0, 20);
  if (trimmed === (room.name || "")) return;

  const now = Date.now();
  const text = trimmed
    ? `${nameOf(myPhone)}님이 채팅방 이름을 '${trimmed}'(으)로 바꿨습니다.`
    : `${nameOf(myPhone)}님이 채팅방 이름을 지웠습니다.`;

  const batch = writeBatch(db);
  batch.update(doc(db, "rooms", room.id), { name: trimmed, lastMessage: text, lastAt: now });
  addSystemMessage(batch, room.id, text, now);
  try {
    await batch.commit();
    closeModal("room-menu");
  } catch (err) {
    console.error(err);
    toast("이름을 바꾸지 못했어요");
  }
}

async function leaveCurrentRoom() {
  const room = currentRoom;
  if (!confirm("채팅방을 나가면 대화 내용이 모두 사라져요. 나갈까요?")) return;

  const now = Date.now();
  const text = `${nameOf(myPhone)}님이 나갔습니다.`;
  const batch = writeBatch(db);
  batch.update(doc(db, "rooms", room.id), {
    members: arrayRemove(myPhone),
    lastMessage: text,
    lastAt: now,
  });
  addSystemMessage(batch, room.id, text, now);
  try {
    await batch.commit();
    closeModal("room-menu");
    closeRoom();
    toast("채팅방을 나갔어요");
  } catch (err) {
    console.error(err);
    toast("나가지 못했어요");
  }
}

