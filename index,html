function cacheUser(user) {
  userInfo.set(user.phone, user);
  userCache.set(user.phone, Promise.resolve(user));
}

function getUser(phone) {
  if (!userCache.has(phone)) {
    userCache.set(
      phone,
      getDoc(doc(db, "users", phone)).then((s) => {
        const user = s.exists() ? s.data() : { phone, nickname: "알 수 없음", photo: "" };
        userInfo.set(phone, user);
        return user;
      })
    );
  }
  return userCache.get(phone);
}

function userOf(phone) {
  if (phone === myPhone && me) return me;
  return userInfo.get(phone) || { phone, nickname: formatPhone(phone), photo: "" };
}

function nameOf(phone) {
  return userOf(phone).nickname;
}

function formatPhone(value) {
  const d = String(value).replace(/\D/g, "").slice(0, 11);
  if (d.length < 4) return d;
  if (d.length < 8) return `${d.slice(0, 3)}-${d.slice(3)}`;
  return `${d.slice(0, 3)}-${d.slice(3, 7)}-${d.slice(7)}`;
}

function onlyDigits(value) {
