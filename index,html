function enterMain(phone) {
  myPhone = phone;
  $("login-screen").classList.add("hidden");
  $("main-screen").classList.remove("hidden");
  showTab("friends");

  // 1) 내 정보 실시간 감시
  const stopMe = onSnapshot(doc(db, "users", phone), (snap) => {
    if (!snap.exists()) return;
    me = snap.data();
    cacheUser(me);
    renderMe();
  });

  // 2) 내 친구 목록 실시간 감시
  const stopFriends = onSnapshot(
    collection(db, "users", phone, "friends"),
    async (snap) => {
      const phones = snap.docs.map((d) => d.id);
      friendSet = new Set(phones);

      // 친구 각각의 최신 프로필 읽어오기
      const profiles = await Promise.all(
        phones.map(async (p) => {
          const s = await getDoc(doc(db, "users", p));
          return s.exists() ? s.data() : null;
        })
      );

      profiles.filter(Boolean).forEach(cacheUser);

      friends = profiles
        .filter(Boolean)
        .sort((a, b) => a.nickname.localeCompare(b.nickname, "ko"));
      renderFriends();
    },
    (err) => console.error(err)
  );

  // 3) 내가 들어가 있는 채팅방 목록 실시간 감시
  const stopRooms = onSnapshot(
    query(collection(db, "rooms"), where("members", "array-contains", phone)),
    async (snap) => {
      const list = snap.docs.map((d) => ({ id: d.id, ...d.data() }));

      // 방에 있는 상대들 프로필 미리 읽어두기
      const others = new Set(list.flatMap((r) => r.members).filter((p) => p !== myPhone));
      await Promise.all([...others].map(getUser));

      // 대화가 하나라도 있는 방만, 최근 대화 순으로
      rooms = list
        .filter((r) => r.lastAt)
        .sort((a, b) => b.lastAt - a.lastAt);
      renderRooms();
    },
    (err) => console.error(err)
  );

  stopListeners = [stopMe, stopFriends, stopRooms];
}

