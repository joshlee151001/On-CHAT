<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OnChat</title>
  <style>
/* ===== 색상 (라이트) ===== */
:root {
  --primary: #FF9F43;
  --primary-dark: #F28A24;
  --primary-soft: #FFF1E3;
  --unread: #FF6B00;
  --danger: #E5484D;
  --bg: #FFFFFF;
  --chat-bg: #FFF4E8;
  --bubble-other: #FFFFFF;
  --text: #1F1F1F;
  --text-sub: #8A8A8A;
  --border: #EEEEEE;
  --input-bg: #F6F6F6;
  --overlay: rgba(0, 0, 0, 0.4);
  --sheet: #FFFFFF;
}

/* ===== 색상 (다크) ===== */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --primary-soft: #3A2A1A;
    --bg: #1C1C1E;
    --chat-bg: #26211C;
    --bubble-other: #3A3A3C;
    --text: #F2F2F2;
    --text-sub: #9A9A9A;
    --border: #333333;
    --input-bg: #2C2C2E;
    --overlay: rgba(0, 0, 0, 0.6);
    --sheet: #2C2C2E;
  }
}
:root[data-theme="dark"] {
  --primary-soft: #3A2A1A;
  --bg: #1C1C1E;
  --chat-bg: #26211C;
  --bubble-other: #3A3A3C;
  --text: #F2F2F2;
  --text-sub: #9A9A9A;
  --border: #333333;
  --input-bg: #2C2C2E;
  --overlay: rgba(0, 0, 0, 0.6);
  --sheet: #2C2C2E;
}

/* ===== 기본 ===== */
* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: -apple-system, "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
  background: var(--bg);
  color: var(--text);
  transition: background 0.2s, color 0.2s;
}

button { font-family: inherit; }

#app {
  position: relative;
  max-width: 420px;
  height: 100vh;
  margin: 0 auto;
  background: var(--bg);
  overflow: hidden;
}

.hidden { display: none !important; }

/* ===== 로그인 ===== */
#login-screen {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.login-box { width: 100%; }
.logo { text-align: center; margin-bottom: 40px; }
.logo-bubble {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  background: var(--primary);
  color: #fff;
  font-size: 26px;
  font-weight: 800;
  border-radius: 24px 24px 24px 6px;
  margin-bottom: 14px;
}
.logo h1 { font-size: 28px; }
.logo .sub { color: var(--text-sub); font-size: 14px; margin-top: 6px; }

.form { display: flex; flex-direction: column; gap: 10px; }

.input {
  width: 100%;
  padding: 15px 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--input-bg);
  color: var(--text);
  font-size: 16px;
  outline: none;
}
.input:focus { border-color: var(--primary); }

.btn {
  padding: 15px;
  border: none;
  border-radius: 12px;
  background: var(--primary);
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}
.btn:active { background: var(--primary-dark); }
.btn:disabled { opacity: 0.5; cursor: default; }
.btn.ghost { background: var(--input-bg); color: var(--text); }
.btn.danger { background: none; color: var(--danger); }

.login-msg { color: var(--unread); font-size: 13px; text-align: center; min-height: 18px; }

/* ===== 메인 (탭 화면 + 하단 탭바) ===== */
#main-screen {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.tab-page {
  flex: 1;
  overflow-y: auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px 12px;
  position: sticky;
  top: 0;
  background: var(--bg);
  z-index: 1;
}
.topbar h2 { font-size: 22px; }

.icon-btn {
  background: none;
  border: none;
  color: var(--text);
  cursor: pointer;
  width: 36px;
  height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
}
.icon-btn:hover { background: var(--input-bg); }
.icon-btn svg { width: 24px; height: 24px; }

/* 하단 탭바 */
.tabbar {
  display: flex;
  border-top: 1px solid var(--border);
  background: var(--bg);
}
.tabbar button {
  flex: 1;
  padding: 10px 0 12px;
  background: none;
  border: none;
  color: var(--text-sub);
  font-size: 11px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  cursor: pointer;
}
.tabbar button svg { width: 24px; height: 24px; }
.tabbar button.active { color: var(--primary); font-weight: 700; }

/* ===== 프로필 행 (친구 목록) ===== */
.person {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 20px;
  cursor: pointer;
}
.person:hover { background: var(--input-bg); }
.person .info { min-width: 0; }
.person .name { font-size: 16px; font-weight: 600; }
.person .sub {
  font-size: 13px;
  color: var(--text-sub);
  margin-top: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.person.me { padding: 12px 20px 18px; }
.person.me .name { font-size: 17px; font-weight: 700; }

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 18px;
  background: var(--primary) center / cover no-repeat;
  color: #fff;
  font-size: 19px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.person.me .avatar { width: 58px; height: 58px; border-radius: 22px; font-size: 22px; }

.divider { height: 1px; background: var(--border); margin: 0 20px; }

.section-title {
  font-size: 12px;
  color: var(--text-sub);
  padding: 14px 20px 6px;
}

.empty {
  color: var(--text-sub);
  text-align: center;
  padding: 50px 20px;
  font-size: 14px;
  line-height: 1.6;
}

/* ===== 설정 ===== */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  font-size: 15px;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  background: none;
  border-left: none;
  border-right: none;
  border-top: none;
  width: 100%;
  color: var(--text);
  text-align: left;
}
.setting-row.danger { color: var(--danger); }

.switch {
  width: 46px;
  height: 28px;
  border-radius: 14px;
  background: var(--border);
  position: relative;
  transition: background 0.2s;
  flex-shrink: 0;
}
.switch::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #fff;
  transition: transform 0.2s;
}
.switch.on { background: var(--primary); }
.switch.on::after { transform: translateX(18px); }

/* ===== 팝업 (모달) ===== */
.overlay {
  position: absolute;
  inset: 0;
  background: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 10;
}
.sheet {
  width: 100%;
  background: var(--sheet);
  border-radius: 20px 20px 0 0;
  padding: 20px 20px 28px;
  animation: up 0.2s ease-out;
}
@keyframes up { from { transform: translateY(40px); opacity: 0; } }

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.sheet-head h3 { font-size: 18px; }

.search-row { display: flex; gap: 8px; }
.search-row .input { flex: 1; }
.search-row .btn { padding: 0 18px; }

.result {
  margin-top: 16px;
  min-height: 90px;
}
.result-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  border-radius: 14px;
  background: var(--primary-soft);
}
.result-card .info { flex: 1; min-width: 0; }
.result-card .name { font-weight: 700; }
.result-card .sub { font-size: 13px; color: var(--text-sub); margin-top: 3px; }
.result-card .btn { padding: 10px 14px; font-size: 14px; }
.result-msg { text-align: center; color: var(--text-sub); font-size: 14px; padding: 30px 0; }

/* 프로필 팝업 */
.profile-big { text-align: center; padding: 10px 0 20px; }
.profile-big .avatar {
  width: 96px;
  height: 96px;
  border-radius: 36px;
  font-size: 36px;
  margin: 0 auto 14px;
}
.profile-big .name { font-size: 20px; font-weight: 700; }
.profile-big .status { color: var(--text-sub); font-size: 14px; margin-top: 6px; min-height: 18px; }
.profile-big .phone { color: var(--text-sub); font-size: 13px; margin-top: 4px; }
.profile-actions { display: flex; flex-direction: column; gap: 8px; }

/* 토스트 */
.toast {
  position: absolute;
  left: 50%;
  top: 70px;
  transform: translateX(-50%);
  background: rgba(30, 30, 30, 0.9);
  color: #fff;
  font-size: 14px;
  padding: 10px 16px;
  border-radius: 20px;
  z-index: 20;
  white-space: nowrap;
}

/* ===== 탭바 배지 ===== */
.tabbar button { position: relative; }
.tab-badge {
  position: absolute;
  top: 4px;
  left: calc(50% + 6px);
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: var(--unread);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  line-height: 18px;
}

/* ===== 채팅 목록 ===== */
.room-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px 20px;
  cursor: pointer;
}
.room-row:hover { background: var(--input-bg); }
.room-row .info { flex: 1; min-width: 0; }
.room-row .name { font-size: 16px; font-weight: 600; }
.room-row .last {
  font-size: 13px;
  color: var(--text-sub);
  margin-top: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.room-row .side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6px;
  flex-shrink: 0;
}
.room-row .time { font-size: 11px; color: var(--text-sub); }
.room-row .badge {
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  border-radius: 10px;
  background: var(--unread);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  line-height: 20px;
  text-align: center;
}

/* ===== 채팅방 ===== */
#chat-screen {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  background: var(--chat-bg);
}
.chat-head {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 12px;
  background: var(--chat-bg);
  border-bottom: 1px solid var(--border);
}
.chat-head h3 {
  flex: 1;
  font-size: 17px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

#msg-list {
  flex: 1;
  overflow-y: auto;
  padding: 10px 12px 16px;
}

.day-divider {
  text-align: center;
  margin: 14px 0 10px;
}
.day-divider span {
  display: inline-block;
  font-size: 12px;
  background: var(--overlay);
  color: #fff;
  padding: 4px 12px;
  border-radius: 12px;
  opacity: 0.8;
}

.msg {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  margin-top: 4px;
}
.msg.first { margin-top: 12px; }
.msg.mine { justify-content: flex-end; }

.msg .avatar,
.msg .avatar-space {
  width: 38px;
  height: 38px;
  border-radius: 15px;
  font-size: 15px;
  align-self: flex-start;
  flex-shrink: 0;
}
.msg .body { max-width: 70%; display: flex; flex-direction: column; }
.msg .sender { font-size: 12px; color: var(--text-sub); margin: 0 0 4px 2px; }
.msg .line { display: flex; align-items: flex-end; gap: 5px; }
.msg.mine .line { flex-direction: row-reverse; }

.bubble {
  padding: 8px 11px;
  border-radius: 14px;
  font-size: 15px;
  line-height: 1.4;
  white-space: pre-wrap;
  word-break: break-word;
  background: var(--bubble-other);
  color: var(--text);
}
.msg.mine .bubble { background: var(--primary); color: #fff; }
.msg.first.other .bubble { border-top-left-radius: 4px; }
.msg.first.mine .bubble { border-top-right-radius: 4px; }

.msg .meta {
  display: flex;
  flex-direction: column;
  font-size: 10px;
  color: var(--text-sub);
  flex-shrink: 0;
  white-space: nowrap;
}
.msg.mine .meta { align-items: flex-end; }
.msg .meta .unread { color: var(--unread); font-weight: 700; font-size: 11px; }

.chat-input {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  padding: 8px 10px;
  background: var(--bg);
  border-top: 1px solid var(--border);
}
.chat-input textarea {
  flex: 1;
  resize: none;
  border: none;
  outline: none;
  background: var(--input-bg);
  color: var(--text);
  border-radius: 18px;
  padding: 9px 14px;
  font-size: 15px;
  font-family: inherit;
  line-height: 1.4;
  max-height: 110px;
}
.send-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: none;
  background: var(--primary);
  color: #fff;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send-btn:disabled { background: var(--border); cursor: default; }
.send-btn svg { width: 18px; height: 18px; }

/* ===== 단톡방 아바타 (여러 명 모자이크) ===== */
.group-avatar {
  width: 48px;
  height: 48px;
  border-radius: 18px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
  background: var(--bg);
  flex-shrink: 0;
}
.group-avatar .avatar {
  width: 100%;
  height: 100%;
  border-radius: 0;
  font-size: 12px;
}
.group-avatar.n2 .avatar { grid-row: span 2; }
.group-avatar.n3 .avatar:first-child { grid-row: span 2; }

.room-row .name .count { color: var(--text-sub); font-weight: 400; margin-left: 4px; font-size: 14px; }
.chat-head .count { color: var(--text-sub); font-weight: 400; margin-left: 4px; font-size: 15px; }

/* ===== 시스템 메시지 (초대/나가기 안내) ===== */
.system-msg { text-align: center; margin: 12px 0; }
.system-msg span {
  display: inline-block;
  font-size: 12px;
  color: var(--text-sub);
  background: var(--primary-soft);
  padding: 5px 12px;
  border-radius: 12px;
  max-width: 85%;
}

/* ===== 사진 메시지 ===== */
.photo {
  display: block;
  max-width: 220px;
  max-height: 300px;
  border-radius: 14px;
  cursor: zoom-in;
  background: var(--border);
  object-fit: cover;
}
.attach-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: none;
  background: none;
  color: var(--text-sub);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.attach-btn svg { width: 24px; height: 24px; }

#viewer {
  position: absolute;
  inset: 0;
  z-index: 30;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}
#viewer img { max-width: 100%; max-height: 100%; }
#viewer .icon-btn { position: absolute; top: 12px; right: 12px; color: #fff; }
#viewer .icon-btn:hover { background: rgba(255, 255, 255, 0.1); }

/* ===== 친구 선택 (단톡 만들기/초대) ===== */
.sheet.tall { max-height: 85%; display: flex; flex-direction: column; }
.pick-list {
  flex: 1;
  overflow-y: auto;
  margin: 12px -20px;
  min-height: 120px;
}
.pick-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 20px;
  cursor: pointer;
}
.pick-row:hover { background: var(--input-bg); }
.pick-row .avatar { width: 40px; height: 40px; border-radius: 15px; font-size: 16px; }
.pick-row .name { flex: 1; font-size: 15px; }
.pick-row.disabled { opacity: 0.45; cursor: default; }
.pick-row .note { font-size: 12px; color: var(--text-sub); }
.check {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid var(--border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pick-row.on .check { background: var(--primary); border-color: var(--primary); }
.pick-row.on .check::after {
  content: "";
  width: 5px;
  height: 10px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg) translate(-1px, -1px);
}

/* ===== 방 메뉴 ===== */
.member-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 7px 0;
}
.member-row .avatar { width: 38px; height: 38px; border-radius: 14px; font-size: 15px; }
.member-row .me-tag {
  font-size: 11px;
  color: #fff;
  background: var(--text-sub);
  border-radius: 8px;
  padding: 1px 6px;
  margin-left: 6px;
}
.menu-members { max-height: 240px; overflow-y: auto; margin-bottom: 14px; }
.menu-list { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
.menu-list button {
  background: none;
  border: none;
  border-bottom: 1px solid var(--border);
  color: var(--text);
  font-size: 15px;
  text-align: left;
  padding: 15px 2px;
  cursor: pointer;
}
.menu-list button.danger { color: var(--danger); }

/* ===== 프로필 편집 ===== */
.edit-photo {
  position: relative;
  width: 96px;
  margin: 4px auto 6px;
}
.edit-photo .avatar { width: 96px; height: 96px; border-radius: 36px; font-size: 36px; }
.edit-photo .cam {
  position: absolute;
  right: -4px;
  bottom: -4px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 3px solid var(--sheet);
  background: var(--text);
  color: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
.edit-photo .cam svg { width: 16px; height: 16px; }
.link-btn {
  display: block;
  margin: 0 auto 16px;
  background: none;
  border: none;
  color: var(--text-sub);
  font-size: 13px;
  text-decoration: underline;
  cursor: pointer;
}
.field-label { font-size: 12px; color: var(--text-sub); margin: 4px 0 -4px 4px; }
  </style>
</head>
<body>
  <div id="app">

    <!-- ========== 로그인 ========== -->
    <section id="login-screen" class="hidden">
      <div class="login-box">
        <div class="logo">
          <div class="logo-bubble">On</div>
          <h1>OnChat</h1>
          <p class="sub">번호 하나로 시작하는 대화</p>
        </div>
        <form id="login-form" class="form">
          <input id="phone" class="input" type="tel" placeholder="전화번호 (010-0000-0000)" maxlength="13" autocomplete="tel" required>
          <input id="nickname" class="input" type="text" placeholder="닉네임 (처음 가입할 때만)" maxlength="12">
          <button type="submit" id="login-btn" class="btn">시작하기</button>
          <p id="login-msg" class="login-msg"></p>
        </form>
      </div>
    </section>

    <!-- ========== 메인 ========== -->
    <section id="main-screen" class="hidden">

      <!-- 친구 탭 -->
      <div id="tab-friends" class="tab-page">
        <header class="topbar">
          <h2>친구</h2>
          <button id="open-add-friend" class="icon-btn" title="친구 추가" aria-label="친구 추가">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="4"/><path d="M2 21c0-3.9 3.1-7 7-7s7 3.1 7 7"/><path d="M19 8v6M16 11h6"/></svg>
          </button>
        </header>

        <div id="my-row"></div>
        <div class="divider"></div>
        <div id="friend-title" class="section-title"></div>
        <div id="friend-list"></div>
      </div>

      <!-- 채팅 탭 -->
      <div id="tab-chats" class="tab-page hidden">
        <header class="topbar">
