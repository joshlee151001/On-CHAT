/* ================= 시간 표시 ================= */
function sameDay(a, b) {
  return a.toDateString() === b.toDateString();
}

// 말풍선 옆: "오후 3:05"
function formatTime(ms) {
  return new Date(ms).toLocaleTimeString("ko-KR", { hour: "numeric", minute: "2-digit" });
}

// 날짜 구분선: "2026년 10월 24일 토요일"
function formatDay(ms) {
  return new Date(ms).toLocaleDateString("ko-KR", {
    year: "numeric", month: "long", day: "numeric", weekday: "long",
  });
}

// 채팅 목록: 오늘이면 시간, 어제면 "어제", 그 외 날짜
function formatListTime(ms) {
  const d = new Date(ms);
  const now = new Date();
  const yesterday = new Date(now);
  yesterday.setDate(now.getDate() - 1);

  if (sameDay(d, now)) return formatTime(ms);
  if (sameDay(d, yesterday)) return "어제";
  if (d.getFullYear() === now.getFullYear()) return `${d.getMonth() + 1}월 ${d.getDate()}일`;
  return d.toLocaleDateString("ko-KR");
}

/* ================= 채팅방 공통 ================= */
function otherMembers(room) {
  return room.members.filter((p) => p !== myPhone);
}

function isGroup(room) {
  return room.type === "group";
}

function roomTitle(room) {
  if (room.name) return room.name;
  const others = otherMembers(room);
  if (others.length === 0) return isGroup(room) ? "대화상대 없음" : nameOf(dmPartner(room));
  return others.map(nameOf).join(", ");
}

// 1:1 방의 상대 (상대가 나갔어도 방 번호로 알 수 있음)
function dmPartner(room) {
  return room.id.split("_").find((p) => p !== myPhone) || myPhone;
}

function myUnread(room) {
  return (room.unread && room.unread[myPhone]) || 0;
}

// 단톡방은 최대 4명 얼굴 모자이크, 1:1은 상대 얼굴
function makeRoomAvatar(room) {
  if (!isGroup(room)) return makeAvatar(userOf(dmPartner(room)));
  const people = otherMembers(room).slice(0, 4);
  if (people.length <= 1) return makeAvatar(userOf(people[0] || myPhone));
  const box = el("div", `group-avatar n${people.length}`);
  people.forEach((p) => box.appendChild(makeAvatar(userOf(p))));
  return box;
}

// 제목 + 인원수 (단톡방만)
function fillTitle(node, room) {
  node.replaceChildren(roomTitle(room));
  if (isGroup(room)) node.appendChild(el("span", "count", String(room.members.length)));
}

/* ================= 채팅 목록 ================= */
function renderRooms() {
  const list = $("room-list");

  // 탭바 배지: 안 읽은 메시지 총합
  const total = rooms.reduce((sum, r) => sum + myUnread(r), 0);
  const badge = $("chat-tab-badge");
  badge.textContent = total > 99 ? "99+" : total;
  badge.classList.toggle("hidden", total === 0);

  if (rooms.length === 0) {
    const empty = el("p", "empty");
    empty.append("아직 대화가 없어요.", el("br"), "오른쪽 위 버튼이나 친구 프로필에서 대화를 시작해 보세요.");
    list.replaceChildren(empty);
    return;
  }

  list.replaceChildren(
    ...rooms.map((room) => {
      const row = el("div", "room-row");

      const info = el("div", "info");
      const name = el("div", "name");
      fillTitle(name, room);
      info.append(name, el("div", "last", room.lastMessage));

      const side = el("div", "side");
      side.append(el("div", "time", formatListTime(room.lastAt)));
      const unread = myUnread(room);
      if (unread > 0) side.append(el("div", "badge", unread > 99 ? "99+" : String(unread)));

      row.append(makeRoomAvatar(room), info, side);
      row.addEventListener("click", () => openRoom(room.id));
      return row;
    })
  );
}

/* ================= 1:1 채팅 시작 ================= */
// 1:1 방 번호는 두 사람 번호를 정렬해서 붙임 → 누가 먼저 열어도 같은 방
async function openDm(friend) {
  const pair = [myPhone, friend.phone].sort();
  const id = pair.join("_");
  const ref = doc(db, "rooms", id);
  const now = Date.now();

  try {
    const snap = await getDoc(ref);
    if (!snap.exists()) {
      await setDoc(ref, {
        type: "dm",
        members: pair,
        lastMessage: "",
        lastAt: 0,
        lastSender: "",
        lastRead: {},
        unread: {},
        joinedAt: { [pair[0]]: now, [pair[1]]: now },
        createdAt: serverTimestamp(),
      });
    } else if (!snap.data().members.includes(myPhone)) {
      // 예전에 내가 나갔던 방 → 다시 들어감 (예전 대화는 안 보임)
      await updateDoc(ref, {
        members: arrayUnion(myPhone),
        [`joinedAt.${myPhone}`]: now,
        [`lastRead.${myPhone}`]: now,
        [`unread.${myPhone}`]: 0,
      });
    }
    cacheUser(friend);
    openRoom(id);
  } catch (err) {
    console.error(err);
    toast("채팅방을 열지 못했어요");
  }
}

